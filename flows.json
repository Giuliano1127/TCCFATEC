    {
        "id": "91c158cb50583d83",
        "type": "function",
        "z": "a8d054d3169e4c7c",
        "name": "function 1",
        "func": "\n// Converte o valor do text input para string, limpa espaços e troca vírgula por ponto\nlet entradaTexto = String(msg.payload).trim().replace(',', '.');\nlet massaKg = parseFloat(entradaTexto);\n\n// Verifica se o que foi digitado é um número válido e positivo\nif (isNaN(massaKg) || massaKg < 0) {\n    node.warn(\"Valor inválido digitado no text input: \" + msg.payload);\n    msg.payload = \"Erro: digite um peso válido em kg\";\n    return msg;\n}\n\n// Parâmetros fixos do seu sistema\nconst gravidade = 9.81; // m/s²\nconst diametroTamborMm = 14; // mm\nconst raioMetros = (diametroTamborMm / 2) / 1000; // 0.007 m\nconst alturaElevacaoMm = 400; // 40 cm = 400 mm\n\n// Cálculos físicos\nconst forcaNewtons = massaKg * gravidade;\nconst torqueNm = forcaNewtons * raioMetros;\nconst torqueKgfCm = massaKg * (diametroTamborMm / 2) / 10;\nconst voltas = alturaElevacaoMm / (Math.PI * diametroTamborMm);\n\n// Formata a saída para exibir direto em um nó \"text\" no Dashboard\nmsg.payload = `${torqueNm.toFixed(4)} N·m (${torqueKgfCm.toFixed(2)} kgf·cm)`;\n\n// Guarda os valores numéricos puros caso precise usar em cálculos futuros ou gráficos\nmsg.dados = {\n    massa_kg: massaKg,\n    torque_Nm: Number(torqueNm.toFixed(4)),\n    torque_kgf_cm: Number(torqueKgfCm.toFixed(2)),\n    voltas_40cm: Number(voltas.toFixed(2))\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 180,
        "wires": [
            [
                "e590db212c7b7c98"
            ]
        ]
